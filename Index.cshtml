
@{
    List<CaiConCac2.Models.Nhanvien> ds = ViewBag.ds;
    ViewBag.Title = "Index";
    int dem = 0; 
}

<style>
    table {width : 700px}

    th , td {border : 1px solid pink ; padding : 3px}
</style>
<h2>Ds may th ngu co so nngay lam < 20</h2>
<table>
    <tr>
        <th> STT</th>
        <th> Ma</th>
        <th> Ma</th>
        <th> Ma</th>
        <th> Ma</th>
        <th> Luong Thuong</th>
    </tr>
    @foreach (var i in ds)
    {
        <tr>
            @if (i.soNgayLam < 20)
            {
                dem++;
                <td> @dem </td>
                <td> @i.ma</td>
                <td> @i.ten</td>
                <td> @i.diaChi</td>
                <td> @i.soNgayLam</td>
                <td> @i.tienThuong</td>
            }
        </tr>
    }

