@model IEnumerable<TX22.Models.HangSanXuat>

@{
    ViewBag.Title = "GetHangSX";
}


<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TenHang)
        </th>
        <th>
           Số lượng sản phẩm
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TenHang)
        </td>
        <td>
           @item.SanPhams.Count()
        </td>
    </tr>
}
</table>
