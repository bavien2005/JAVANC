<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true">

    <!-- Tên -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Tên:"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/edtTen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="&lt;nhập tên&gt;"
            android:inputType="textPersonName"
            android:singleLine="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#777777"/>

    <!-- Tuổi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Tuổi"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/edtTuoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="&lt;nhập tuổi&gt;"
            android:inputType="number"
            android:singleLine="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#777777"/>

    <!-- Lĩnh vực -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Lĩnh vực"
            android:textSize="16sp"/>

        <CheckBox
            android:id="@+id/cbLapTrinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lập trình"
            android:textSize="14sp"/>

        <CheckBox
            android:id="@+id/cbKiemThu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiểm thử"
            android:textSize="14sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#777777"/>

    <!-- Ngày hẹn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Ngày hẹn"
            android:textSize="16sp"/>

        <CheckBox
            android:id="@+id/cbThu2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 2"
            android:checked="true"
            android:textSize="14sp"/>

        <CheckBox
            android:id="@+id/cbThu5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 5"
            android:checked="true"
            android:textSize="14sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#777777"/>

    <!-- Ba nút -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnThemMoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Thêm Mới"
            android:textSize="13sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnSua"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Sửa"
            android:textSize="13sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnThongKe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Thống kê"
            android:textSize="13sp"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Danh sách -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listview:"
        android:textSize="18sp"
        android:paddingTop="8dp"/>

    <ListView
        android:id="@+id/listViewDangKy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="#777777"
        android:dividerHeight="1dp"/>

</LinearLayout>
