@model CaiConCac2.Models.Nhanvien
@{
    ViewBag.Title = "Input";
}

@using (Html.BeginForm())
{
    <p>
        Mã :
        @Html.TextBoxFor(m => m.ma)
        @Html.ValidationMessageFor(m => m.ma)
    </p>
    <p>
        Tên :
        @Html.TextBoxFor(m => m.ten)
        @Html.ValidationMessageFor(m => m.ten)
    </p>
    <p>
        Dchi:
        @*@Html.DropDownListFor(m => m.diaChi, new SelectList(new[] { "QN", "HNOI", "CONCAC" }))*@
        @Html.RadioButtonFor(m => m.diaChi, "Nam", new { id = "nam" })
        <label for="nam">Nam</label>

        @Html.RadioButtonFor(m => m.diaChi, "Nữ", new { id = "nu" })
        <label for="nu">Nữ</label>

        @Html.RadioButtonFor(m => m.diaChi, "Khác", new { id = "khac" })
        <label for="khac">Khác</label>
    </p>
    <p>
        So Ngay Lam :
        @Html.TextBoxFor(m => m.soNgayLam)
        @Html.ValidationMessageFor(m => m.soNgayLam)
    </p>
    <p>
        Lương :
        @Html.TextBoxFor(m => m.luong)
        @Html.ValidationMessageFor(m => m.luong)
    </p>
    <button type="submit"> submit </button>
}

